# Copie este arquivo para .env e preencha. O .env NÃO deve ir para o Git.

# API externa de e-mail (https://resend.com -> API Keys). Sem a chave, os e-mails
# de promoção são apenas simulados no log do MS Promoções.
RESEND_API_KEY=
# Remetente. Sem domínio próprio verificado no Resend, use o remetente de testes
# abaixo: nesse modo o Resend só entrega para o e-mail dono da conta Resend.
RESEND_FROM=Loja SD <onboarding@resend.dev>

# Porta AMQP do RabbitMQ no host (padrão 5672)
RABBIT_PORT=5672
